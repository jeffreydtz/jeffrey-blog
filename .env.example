# URL del proyecto Supabase de las reacciones (el de bot-salesforce, ref cullwwdkcgnwgqjmfmqn)
SUPABASE_URL=
# Service role key de ese proyecto — SOLO server (route handlers); jamás con prefijo NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=
# URL canónica del sitio para metadata/RSS/sitemap/OG (ej: https://jeffrey-blog-tau.vercel.app)
NEXT_PUBLIC_SITE_URL=

# --- Panel /admin (opcional: sin estas dos, el panel queda deshabilitado) ---
# Contraseña del panel. Cambiarla invalida las sesiones vivas.
ADMIN_PASSWORD=
# Token fine-grained de GitHub con permiso Contents: Read and write sobre el repo — SOLO server
# Un token de solo lectura da 403 "Resource not accessible by personal access token" al guardar.
GITHUB_TOKEN=
# Deploy Hook de Vercel (Settings → Git → Deploy Hooks): publica tras cada guardado
VERCEL_DEPLOY_HOOK_URL=
# Overrides opcionales (defaults: jeffreydtz/jeffrey-blog, main)
# ADMIN_GITHUB_REPO=
# ADMIN_GITHUB_BRANCH=
